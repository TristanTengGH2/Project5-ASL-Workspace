{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshape sign catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "description", "language", "sources", "signs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 1 },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": { "const": "ase" },
        "name": { "const": "American Sign Language" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "downloadId", "name", "version", "license", "licenseUrl", "attribution", "datasetUrl", "downloadGuideUrl", "verifiedAt", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "downloadId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "licenseUrl": { "type": "string", "pattern": "^https://" },
          "attribution": { "type": "string", "minLength": 1 },
          "datasetUrl": { "type": "string", "pattern": "^https://" },
          "downloadGuideUrl": { "type": "string", "pattern": "^https://" },
          "verifiedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "signs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "language", "displayGloss", "englishGlosses", "source", "status", "archives", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$" },
          "language": { "const": "ase" },
          "displayGloss": { "type": "string", "minLength": 1 },
          "englishGlosses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "category", "slug"],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 },
              "category": { "enum": ["game", "non-game"] },
              "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" }
            }
          },
          "status": { "enum": ["sample", "candidate", "supported", "rejected"] },
          "archives": {
            "type": "object",
            "additionalProperties": false,
            "required": ["train", "val", "test"],
            "properties": {
              "train": { "type": "string", "pattern": "^https://" },
              "val": { "type": "string", "pattern": "^https://" },
              "test": { "type": "string", "pattern": "^https://" }
            }
          },
          "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
